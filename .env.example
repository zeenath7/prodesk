# Admin access — /admin/login (cookie sessions, Neon-backed)
ADMIN_USERNAME=admin
ADMIN_PASSWORD=replace-with-a-long-random-password

# 32+ random characters. Required to sign admin session cookies.
# Generate: openssl rand -base64 48  (or: node -e "console.log(require('crypto').randomBytes(48).toString('base64'))")
AUTH_SECRET=replace-with-openssl-rand-base64-48-output

# Neon Postgres connection string. When set, admin credentials live in the
# `admin_users` table (scrypt hashes) instead of env comparison.
# First login with ADMIN_USERNAME/ADMIN_PASSWORD auto-seeds the Neon user,
# or pre-seed with: npm run admin:create -- <username> <password>
DATABASE_URL=postgresql://user:password@ep-xxxx.neon.tech/neondb?sslmode=require

# Vercel Blob token for admin product-image uploads (bytes) — refs in Neon `product_images`.
# Vercel dashboard → Storage → Blob store → .env.local / Connect. Required for uploads.
BLOB_READ_WRITE_TOKEN=vercel_blob_rw_xxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
